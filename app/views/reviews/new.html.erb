<div class="border border-yellow-600 border-4">   
    <div class="flex ml-5">
        <p class="mt-3 font-semibold text-lg"> Submit your review</p>
    </div>
</div>
<div class="border mt-8 border-black w-full h-screen border-4"> 
    <%=form_with model: @review, url: movie_reviews_path(@movie) do |f|%>
        <div class="mt-5 flex flex-col mt-3 ml-5">
            <%= f.label :description, class: 'font-bold text-lg leading-6'%>
            <%= f.text_area :description, class: 'mt-2 mr-3 border border-1 border-black font-medium text-sm leading-6'%>
        </div>
        <div class="flex flex-col mt-3 ml-5">
            <%= f.label :rating, class: 'font-bold text-lg leading-6'%>
            <%= f.range_field :rating, min: 1, max: 6, class: 'mt-2 mr-3 font-medium text-sm leading-6'%>
        </div>
        <div class="flex flex-col mt-3 ml-5">
            <%=f.submit 'Submit review', class: 'border-2 h-20 w-40 border-black bg-yellow-400 mr-3 mb-2 hover:bg-yellow-500 cursor-pointer rounded px-3 py-2 text-black hover:text-white font-semibold'%>
        </div>
    <%end%>
</div>
